<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.web>
        <customErrors mode="Off" />
    </system.web>
    <system.webServer>
        <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />
        <asp scriptErrorSentToBrowser="true" />
    </system.webServer>
</configuration>
